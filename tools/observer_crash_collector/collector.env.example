# Observer crash collector configuration.
# Copy to /etc/observer-crash-collector/collector.env and keep it root-owned.

# Broker connection.
OBSERVER_CRASH_HOST=mqtt.example.net
#OBSERVER_CRASH_PORT=1883
#OBSERVER_CRASH_TLS=false
#OBSERVER_CRASH_WS=false
#OBSERVER_CRASH_WS_PATH=/mqtt

# Authentication. Prefer the password file over the inline value.
#OBSERVER_CRASH_USERNAME=observer-reader
#OBSERVER_CRASH_PASSWORD=
#OBSERVER_CRASH_PASSWORD_FILE=/etc/observer-crash-collector/mqtt-password

# Subscription and client identity.
#OBSERVER_CRASH_TOPIC=meshcore/+/+/status
#OBSERVER_CRASH_CLIENT_ID=observer-crash-collector-service
#OBSERVER_CRASH_KEEPALIVE=60

# TLS. Leave CA_FILE unset to use the system trust store.
#OBSERVER_CRASH_CA_FILE=/etc/ssl/certs/ca-certificates.crt
#OBSERVER_CRASH_TLS_INSECURE=false

# Output and limits.
OBSERVER_CRASH_OUTPUT=/var/lib/observer-crash-collector/events.jsonl
#OBSERVER_CRASH_MAX_BYTES=20971520
#OBSERVER_CRASH_MAX_PAYLOAD=65536
#OBSERVER_CRASH_NODE_CACHE=20000
#OBSERVER_CRASH_BACKOFF_MAX=60
#OBSERVER_CRASH_SNAPSHOT_INTERVAL=60
